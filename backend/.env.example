# ==============================================================================
# Backend Production & Development Environment Variable Template
# ==============================================================================
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/resumebuilder

# Cryptographic signing key for JWT tokens (Generate via `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`)
JWT_SECRET=change_this_to_a_secure_256_bit_random_secret_string_in_production

# Optional SMTP Email Service Credentials for password reset notifications
EMAIL=your-service-email@example.com
EMAIL_PASS=your-secure-smtp-app-password

# Optional Google Gemini AI API Key (falls back to deterministic NLP if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
