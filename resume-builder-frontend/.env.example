# ==============================================================================
# ResumeBuilder Frontend Environment Variable Template
# ==============================================================================

# Backend API Endpoint URL (defaults to http://localhost:5000/api in development)
REACT_APP_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID for One-Tap and Google Sign-In
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
